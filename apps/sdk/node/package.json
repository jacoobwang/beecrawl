{
  "name": "beecrawl-sdk",
  "version": "0.1.0",
  "description": "Node.js SDK for the BeeCrawl HTTP API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacoobwang/beecrawl.git",
    "directory": "apps/sdk/node"
  },
  "homepage": "https://beecrawl.dev/docs/sdk-node",
  "bugs": {
    "url": "https://github.com/jacoobwang/beecrawl/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "beecrawl",
    "crawler",
    "scraper",
    "extract"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
